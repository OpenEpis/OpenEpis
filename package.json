{
  "name": "openepis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@openepis/web",
    "dev:server": "turbo dev --filter=@openepis/server",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "prettier --check .",
    "db:pg:generate": "turbo db:generate --filter=@openepis/storage-pg",
    "db:pg:migrate": "turbo db:migrate --filter=@openepis/storage-pg",
    "db:pg:push": "turbo db:push --filter=@openepis/storage-pg",
    "db:pg:studio": "turbo db:studio --filter=@openepis/storage-pg",
    "test:e2e": "playwright test",
    "eval": "playwright test --project=eval",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postgres": "^3.4.8",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
